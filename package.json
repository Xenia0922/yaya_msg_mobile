{
  "name": "yaya_msg-mobile",
  "version": "2.7.5",
  "description": "口袋48 第三方 React Native 移动客户端",
  "homepage": "https://github.com/Xenia0922/yaya_msg_mobile",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xenia0922/yaya_msg_mobile"
  },
  "bugs": {
    "url": "https://github.com/Xenia0922/yaya_msg_mobile/issues"
  },
  "author": "Xenia",
  "license": "GPL-3.0",
  "private": true,
  "main": "index.ts",
  "expo": {
    "autolinking": {
      "exclude": [
        "react-native-safe-area-context"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "build:android": "cd android && gradlew assembleRelease -Dorg.gradle.daemon=true -Dorg.gradle.parallel=false",
    "build:android:copy": "node scripts/build-apk.js",
    "gen:wasm": "node scripts/gen-wasm-base64.mjs",
    "verify:version": "node scripts/verify-version.js",
    "test:core": "node scripts/melee-parse.test.mjs && node scripts/network-request.test.mjs",
    "typecheck": "tsc --noEmit && node scripts/verify-version.js"
  },
  "dependencies": {
    "@kesha-antonov/react-native-chat": "^5.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-navigation/bottom-tabs": "^7.15.10",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/stack": "^7.8.11",
    "@shopify/flash-list": "^2.3.2",
    "expo": "^55.0.0",
    "expo-asset": "~55.0.20",
    "expo-blur": "~55.0.18",
    "expo-file-system": "~55.0.26",
    "expo-image-picker": "~55.0.24",
    "expo-linear-gradient": "~55.0.18",
    "expo-media-library": "~55.0.21",
    "expo-screen-orientation": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "pako": "^3.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "^1.22.5",
    "react-native-liquid-glassmorphism": "^1.2.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-vector-icons": "^9.2.0",
    "react-native-video": "^6.19.2",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.3",
    "@react-native/metro-config": "^0.83.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.10",
    "typescript": "~5.9.2"
  }
}
